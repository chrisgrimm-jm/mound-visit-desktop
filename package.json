{
  "name": "mound-visit-desktop",
  "productName": "Mound Visit",
  "version": "1.3.0",
  "description": "Desktop wrapper for Jomboy Media's Mound Visit: loads the hosted page, opens the talent Display fullscreen on the second monitor, auto-selects the OBS projector for capture.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "sync": "cp ../confidence-monitor/index.html app/index.html",
    "dist": "electron-builder --win"
  },
  "build": {
    "appId": "com.jomboymedia.confidencemonitor",
    "files": [
      "main.js",
      "preload.js",
      "app/**"
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Mound Visit",
      "artifactName": "Mound-Visit-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "Mound-Visit-Portable-${version}.exe"
    }
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  }
}
